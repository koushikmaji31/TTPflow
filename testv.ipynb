   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt \n",
    "import torch\n",
    "frequencies = np.geomspace(1, 1024, num=11)\n",
    "scale = np.repeat(2 * np.pi * frequencies /10, 2)\n",
    "bias = np.tile(np.array([0, np.pi / 2]), 11)\n",
    "\n",
    "plt.figure()\n",
    "plt.scatter([bias[i] for i in range(len(bias))],scale)\n",
    "plt.show()\n",
    "\n"
   ]
  }
